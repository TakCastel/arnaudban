# Copier ce fichier en `.env` (jamais commité, voir .gitignore) et remplir
# les valeurs réelles directement sur le VPS.

# Compte Outlook utilisé pour ENVOYER les mails du formulaire de contact.
MAIL_USER=ban.arnaud@outlook.fr

# Mot de passe d'application généré depuis le compte Microsoft — surtout PAS
# le mot de passe du compte lui-même. Marche à suivre dans README.md.
MAIL_PASS=

# Adresse qui REÇOIT les messages du formulaire (par défaut : MAIL_USER).
MAIL_TO=ban.arnaud@outlook.fr

# Origine(s) autorisée(s) à appeler cette API (protection CORS). Plusieurs
# valeurs séparées par une virgule si besoin.
ALLOWED_ORIGIN=https://arnaudban.fr

# Port local du process Node (nginx fait ensuite le reverse proxy dessus,
# voir README.md — ce port n'est jamais exposé directement sur internet).
PORT=3001
